{
  "name": "calinmeters-inquiry-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run deploy:dry",
    "cf-typegen": "wrangler types",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types --check && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "dependencies": {
    "resend": "6.19.0"
  }
}
